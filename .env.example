# =============================================================================
# Sovereign AI Workbench — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your machine.
# All services must resolve to localhost. No external URLs are permitted.
#
#   cp .env.example .env
#
# The application will work with these defaults on a fresh install.
# =============================================================================


# -----------------------------------------------------------------------------
# AI Models
# -----------------------------------------------------------------------------

# Base URL of the local Ollama daemon.
# Must remain a loopback address in sovereign mode.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Primary reasoning / general-purpose model.
MAIN_MODEL=qwen3:4b

# Code generation and debugging model.
CODE_MODEL=qwen2.5-coder:7b

# Vision / multimodal model (P&ID diagrams, scanned documents).
VISION_MODEL=qwen2.5vl:3b

# Request timeout for Ollama inference calls (seconds).
OLLAMA_TIMEOUT=120


# -----------------------------------------------------------------------------
# Storage — all paths are relative to the project root
# -----------------------------------------------------------------------------

# Directory for user-uploaded files (documents and images).
UPLOAD_DIR=data/uploads

# SQLite database file used for task persistence and audit logs.
DB_PATH=data/app.db

# ChromaDB vector store directory.
CHROMA_DIR=data/vector_db

# Directory for generated Office artifacts (DOCX, XLSX, PPTX).
ARTIFACT_DIR=data/artifacts

# Append-only JSONL audit log (human-readable sovereignty record).
AUDIT_LOG_PATH=logs/audit.jsonl

# Scratch space for sandboxed execution temp files and rendered pages.
EXECUTIONS_DIR=data/executions


# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

# Enable sovereign mode — blocks any non-loopback outbound connection
# attempted through the application's NetworkMonitor guard.
# Set to false only in a controlled development environment.
SOVEREIGN_MODE=true

# Docker network mode for sandboxed Python execution.
# "none" disables all networking inside the container.
# Do NOT change this to "bridge" or "host" on a demo machine.
SANDBOX_NETWORK_MODE=none

# Docker image used for the Python sandbox.
SANDBOX_IMAGE=python:3.13-slim

# Maximum wall-clock seconds a sandboxed script may run before
# the container is killed.
SANDBOX_TIMEOUT=10

# Memory cap for each sandbox container.
SANDBOX_MEMORY=512m


# -----------------------------------------------------------------------------
# API Server
# -----------------------------------------------------------------------------

# Bind address — keep this as 127.0.0.1 on a demo machine.
# Change to 0.0.0.0 only if the UI is served from a different host.
API_HOST=127.0.0.1

API_PORT=8000

# Log level: debug | info | warning | error
LOG_LEVEL=info
